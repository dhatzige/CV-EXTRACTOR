# Anthropic API key — required for the /api/extract endpoint
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: preferred Claude model. If unset (or retired), the app falls back
# through the current-generation models and finally asks the API what exists.
# Current IDs: https://docs.anthropic.com/en/docs/about-claude/models
# CLAUDE_MODEL=claude-opus-4-6
